{
  "name": "@fitness/exercises",
  "private": true,
  "description": "Exercise library: free-exercise-db (pinned) normalised into typed exercises, with step images and matched ExerciseDB GIF demos served as static assets.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./naming": "./src/naming.ts"
  },
  "scripts": {
    "fetch:data": "tsx scripts/fetch.ts",
    "fetch:images": "tsx scripts/fetch.ts --images",
    "match:media": "tsx scripts/match-media.ts",
    "fetch:media": "tsx scripts/fetch-media.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fitness/shared": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "tsx": "catalog:",
    "@types/node": "catalog:"
  }
}
