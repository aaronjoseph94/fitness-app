  "providers": {
    "gemini": {
      "api": "gemini",
      "base_url": "https://generativelanguage.googleapis.com/v1beta",
      "key_env": "GEMINI_API_KEY",
      "source": "https://ai.google.dev/gemini-api/docs/rate-limits — free-tier numbers are shown only in AI Studio (https://aistudio.google.com/rate-limit); limits are per project, RPD resets at midnight Pacific."
    },
    "zai": {
      "api": "openai",
      "base_url": "https://api.z.ai/api/paas/v4",
      "key_env": "ZAI_API_KEY",
      "source": "https://docs.z.ai/guides/overview/pricing (GLM-4.7-Flash, GLM-4.5-Flash, GLM-4.6V-Flash are Free). Free Flash models are limited by concurrency (1 request in flight per model); no published daily cap — see https://z.ai/manage-apikey/rate-limits."
    },
    "openrouter": {
      "api": "openai",
      "base_url": "https://openrouter.ai/api/v1",
      "key_env": "OPENROUTER_API_KEY",
      "headers": { "X-Title": "Fitness Tracker" },
      "source": "https://openrouter.ai/docs/api/reference/limits — :free models: 20 RPM; 50 RPD account-wide (1,000 RPD after $10 of credits ever purchased)."
    },
    "groq": {
      "api": "openai",
      "base_url": "https://api.groq.com/openai/v1",
      "key_env": "GROQ_API_KEY",
